{
    "name": "decodelabs/nightfire",
    "description": "Composable view blocks",
    "type": "library",
    "keywords": [],
    "license": "MIT",
    "authors": [
        {
            "name": "Tom Wright",
            "email": "tom@inflatablecookie.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/polyfill-php85": "^1.33",

        "decodelabs/archetype": "^0.4.2",
        "decodelabs/coercion": "^0.3.5",
        "decodelabs/exceptional": "^0.6.3",
        "decodelabs/exemplar": "^0.5.10",
        "decodelabs/kingdom": "^0.2.0",
        "decodelabs/nuance": "^0.2.2",
        "decodelabs/slingshot": "^0.3.5",
        "decodelabs/tagged": "^0.21.3"
    },
    "require-dev": {
        "decodelabs/chorus": "^0.1",
        "decodelabs/phpstan-decodelabs": "^0.7.0"
    },
    "autoload": {
        "psr-4": {
            "DecodeLabs\\Nightfire\\": "src/Nightfire/"
        },
        "classmap": [
            "src/Nightfire.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "0.1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
